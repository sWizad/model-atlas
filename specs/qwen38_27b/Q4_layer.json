  "notes": [
    {
      "row": "notes",
      "title": "The order in one line",
      "text": "norm → MIXER → add → norm → SwiGLU MLP → add. Two norms, both pre-norm; the MLP is identical in every layer regardless of type. Compare Gemma-4's four norms and Wan's six AdaLN taps — this is the minimal version.",
      "code": [
        {
          "role": "definition",
          "src": "qwen35.hf",
          "lines": [
            782,
            813
          ],
          "expect": {
            "symbol": "Qwen3_5DecoderLayer.forward",
            "first": "residual = hidden_states",
            "sha": "33782fbf",
            "span": [
              773,
              813
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "The MLP never changes",
      "text": "self.mlp is built the same way for both block types, with config.intermediate_size. Whatever the mixer does, the channel-mixing half of the layer is one SwiGLU — which is why the interesting comparison is one level down.",
      "code": [
        {
          "role": "definition",
          "src": "qwen35.hf",
          "lines": [
            769,
            769
          ],
          "expect": {
            "symbol": "Qwen3_5DecoderLayer.mlp",
            "first": "self.mlp = Qwen3_5MLP(config, config.intermediate_size)",
            "sha": "d751c16f",
            "span": [
              769,
              769
            ]
          }
        }
      ]
