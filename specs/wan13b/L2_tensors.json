  "notes": [
    {
      "row": "notes",
      "title": "Three streams, three roles — the asymmetry is the point",
      "text": "Attention length is 32760, not 32760 + 512: text is never concatenated into the sequence, it is only ever K/V. And e0 is not a sequence at all — it is six per-channel vectors that shift, scale and gate inside each block. Only x is read and written.",
      "code": [
        {
          "role": "definition",
          "src": "wan.model",
          "lines": [
            487,
            497
          ],
          "expect": {
            "symbol": "WanModel.forward",
            "first": "kwargs = dict(",
            "sha": "543ed6f7",
            "span": [
              416,
              503
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "Padding to seq_len",
      "text": "Each sample is right-padded with zeros to a common seq_len and the true lengths travel alongside as seq_lens, which flash-attention uses as k_lens so padding never contributes.",
      "code": [
