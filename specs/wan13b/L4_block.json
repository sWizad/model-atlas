  "notes": [
    {
      "row": "notes",
      "title": "The order in one line",
      "text": "norm1 → modulate → SELF-ATTN → gated add → norm3 → CROSS-ATTN → plain add → norm2 → modulate → MLP → gated add.  Pre-norm throughout: every sublayer normalises its input, never its output, and the residual stream is never normalised.",
      "code": [
        {
          "role": "definition",
          "src": "wan.model",
          "lines": [
            243,
            265
          ],
          "expect": {
            "symbol": "WanAttentionBlock.forward",
            "first": "assert e.dtype == torch.float32",
            "sha": "08f574ff",
            "span": [
              225,
              265
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "Where the 6 taps go",
      "text": "e[0] shift and e[1] scale feed self-attention's input; e[2] gates its output. e[3] shift and e[4] scale feed the MLP's input; e[5] gates its output. Cross-attention gets none of them.",
      "code": [
        {
          "role": "call_site",
          "src": "wan.model",
          "lines": [
            243,
            253
          ],
          "expect": {
            "symbol": "WanAttentionBlock.forward",
            "first": "assert e.dtype == torch.float32",
            "sha": "fabb2d39",
            "span": [
              225,
              265
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "Three precision boundaries",
      "text": "The modulation arithmetic and both gated residuals run under an explicit float32 autocast, and the norms cast to float32 internally before casting back. Everything else runs in bf16. Getting this wrong is a classic source of drift in a finetune.",
      "code": [
        {
          "role": "call_site",
          "src": "wan.model",
          "lines": [
            244,
            253
          ],
          "expect": {
            "symbol": "WanAttentionBlock.forward",
            "first": "with torch.amp.autocast(autocast_device_type(), dtype=torch.float32):",
            "sha": "3172ba9b",
            "span": [
              225,
              265
            ]
          }
        }
      ]
    }
  ],
