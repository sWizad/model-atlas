  "notes": [
    {
      "row": "notes",
      "title": "Why the patch is (1, 2, 2) and the head outputs 64",
      "text": "Each token covers one latent frame and a 2×2 spatial patch. The head must therefore predict {{cfg.out_dim}} channels × 4 positions = 64 numbers per token, and unpatchify scatters them back onto the grid. Change the patch size and both numbers move together.",
      "code": [
        {
          "role": "definition",
          "src": "wan.model",
          "lines": [
            278,
            281
          ],
          "expect": {
            "symbol": "Head.__init__",
            "first": "out_dim = math.prod(patch_size) * out_dim",
            "sha": "04b12d36",
            "span": [
              270,
              283
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "RMSNorm vs LayerNorm in this model",
      "text": "WanRMSNorm (learnable gain, no mean subtraction) is used only for QK-norm inside attention. WanLayerNorm (usually affine-free) is used for every block norm and for the head. They are not interchangeable here.",
      "code": [
        {
          "role": "definition",
          "src": "wan.model",
          "lines": [
            75,
            91
