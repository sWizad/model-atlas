  "notes": [
    {
      "row": "notes",
      "title": "The three differences, and nothing else",
      "text": "1 — K and V read context instead of x.  2 — no RoPE on either side.  3 — k_lens is the text length, not the video length. The projections, the QK-RMSNorm, the kernel and the output projection are literally the same code path.",
      "code": [
        {
          "role": "definition",
          "src": "wan.model",
          "lines": [
            164,
            174
          ],
          "expect": {
            "symbol": "WanCrossAttention",
            "first": "class WanCrossAttention(WanSelfAttention):",
            "sha": "a2915324",
            "span": [
              164,
              186
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "No GQA, no KV cache",
      "text": "q, k and v are all full width ({{cfg.dim}} → {{cfg.dim}}, {{cfg.num_heads}} heads each) — this is plain MHA, not grouped-query. A diffusion model re-attends the whole sequence every step, so there is nothing to cache.",
      "code": [
        {
          "role": "definition",
          "src": "wan.model",
          "lines": [
            107,
            131
          ],
          "expect": {
            "symbol": "WanSelfAttention",
            "first": "class WanSelfAttention(nn.Module):",
            "sha": "f936cb44",
            "span": [
              107,
              161
            ]
          }
        }
      ]
    }
