  "bands": [
    {
      "id": "loop",
      "rows": [
        "loop"
      ],
      "lanes": "*",
      "style": "dark",
      "selectable": true,
      "label": "for t in timesteps:   WanModel(x, t, context) twice — conditional and unconditional   →   CFG mix   →   scheduler.step",
      "dim": "the DiT is called 2 × N times; N is typically 40–50",
      "drill": "L1b_step",
      "note": "Classifier-free guidance costs a second full forward pass per step. noise_pred = uncond + scale · (cond − uncond), then the flow-matching scheduler takes one step along the velocity.",
