  "notes": [
    {
      "row": "notes",
      "title": "A hybrid cache, not one cache",
      "text": "Five of every six layers attend only to the last 1024 positions, so their cache is bounded; the sixth keeps everything. That is what makes a 262k context affordable — only 10 of the 60 layers pay full price for it.",
      "code": [
        {
          "role": "definition",
          "src": "gemma4.hf",
          "lines": [
            1126,
            1140
          ],
