  "notes": [
    {
      "row": "notes",
      "title": "Fixed cost per image, whatever its size",
      "text": "280 soft tokens per image regardless of resolution, because the pooler divides by whatever k makes the arithmetic work. A 4× bigger image costs the language model nothing extra — it just averages harder. That is the opposite trade to Qwen3-VL, where tokens scale with pixels.",
      "code": [
        {
          "role": "definition",
          "src": "gemma4.hf",
          "lines": [
            589,
            595
          ],
          "expect": {
            "symbol": "Gemma4VisionPooler._avg_pool_by_positions",
