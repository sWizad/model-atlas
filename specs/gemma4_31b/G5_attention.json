  "notes": [
    {
      "row": "notes",
      "title": "Why two geometries instead of one",
      "text": "50 cheap layers do local work on a bounded cache; 10 wide layers carry the context. Per full layer the cache holds 4 heads × 512 and V aliases K, so one global layer caches about the same bytes as one sliding layer does per token — while seeing the whole 262k window.",
      "code": [
        {
          "role": "definition",
          "src": "gemma4.hf",
          "lines": [
            1133,
            1146
          ],
          "expect": {
            "symbol": "Gemma4TextAttention.__init__",
            "first": "self.layer_idx = layer_idx",
            "sha": "e2400cb3",
            "span": [
              1129,
              1183
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "What the serving path does differently",
      "text": "vLLM fuses Q/K/V into one projection and selects the rope per layer type at construction, then uses paged attention with per_layer_sliding_window. Same maths, different tensors in memory — read the vllm tab when a shape on this page does not match a profile.",
      "code": [
        {
          "role": "definition",
          "src": "gemma4.vllm",
          "lines": [
            432,
            500
          ],
