            "span": [
              1129,
              1183
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "KV sharing is implemented but off here",
      "text": "num_kv_shared_layers = 0 in this checkpoint, so is_kv_shared_layer is never true and every layer computes its own K/V. The shared_kv_states plumbing still runs through every forward, carrying an empty dict.",
      "code": [
