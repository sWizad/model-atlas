  "notes": [
    {
      "row": "notes",
      "title": "Row order is the caller's job, not the model's",
      "text": "build_packed_sequence lays the rows out as text ‖ conditioning ‖ audio ‖ video and returns the tags, the (t,h,w) grid and the index lists. The DiT validates shapes and otherwise trusts that layout completely — which is why a wrong row order fails silently rather than loudly.",
      "code": [
        {
          "role": "definition",
          "src": "mmx.pipe",
          "lines": [
            974,
            983
          ],
          "expect": {
            "symbol": "build_packed_sequence",
            "first": "num_text_tokens = text_token_tags.shape[0]",
            "sha": "d91e0ffc",
            "span": [
              943,
              1040
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "Padding rows get their own attention document",
      "text": "Rows tagged −1 must not exchange attention with live rows. A boolean mask pairing pad-with-pad and live-with-live reproduces the reference's cu_seqlens split. A padless sequence keeps the mask at None so the flash-attention fast path stays available — so dropping padding is faster, not just tidier.",
      "code": [
        {
          "role": "definition",
          "src": "mmx.dit",
          "lines": [
            703,
            710
          ],
          "expect": {
            "symbol": "MiniMaxH3Transformer3DModel.forward",
            "first": "# 4. Padding rows (tag `-1`) must not exchange attention with live rows: the reference keeps the padding tail",
            "sha": "e2ce8fc1",
            "span": [
              612,
              770
            ]
          }
        }
      ]
    }
