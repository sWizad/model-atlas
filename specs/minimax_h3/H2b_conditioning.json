  "notes": [
    {
      "row": "notes",
      "title": "Two tasks, two layouts, one mechanism",
      "text": "FL2VA packs [text ‖ keyframe rows ‖ target audio ‖ target video] and pins each keyframe to \"first\" or \"last\". Ref2VA packs [text ‖ reference blocks ‖ target audio ‖ target video] and lets each reference push the shared clock forward. Different builders, identical idea: extra low-noise video rows at a chosen place on the clock.",
      "code": [
        {
          "role": "fl2va",
          "src": "mmx.pipe",
          "lines": [
            943,
            983
          ],
          "expect": {
            "symbol": "build_packed_sequence",
            "first": "def build_packed_sequence(",
            "sha": "3b3ee3b0",
            "span": [
              943,
              1040
            ]
          }
        },
        {
          "role": "ref2va",
          "src": "mmx.pipe",
          "lines": [
            1255,
            1274
