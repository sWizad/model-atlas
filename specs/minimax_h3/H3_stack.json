  "notes": [
    {
      "row": "notes",
      "title": "Sequence parallelism splits rows, not heads",
      "text": "With more than one GPU the sequence is padded to a multiple of the world size and each rank keeps a slice of ROWS; the attention processor all-gathers keys and values. A padded (masked) sequence is rejected outright in this mode.",
      "code": [
        {
          "role": "definition",
          "src": "mmx.dit",
          "lines": [
            712,
            736
          ],
          "expect": {
            "symbol": "MiniMaxH3Transformer3DModel.forward",
            "first": "# 5. Sequence parallel: pad the sequence up to a multiple of the group size and keep only this rank's rows.",
            "sha": "788c7037",
            "span": [
              612,
              770
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "Mixed precision is part of the checkpoint",
      "text": "The two patch projections, the timestep MLP and the two output heads ship as float32 while the 50 blocks run in bfloat16. Casting the whole model to one dtype changes the numbers.",
