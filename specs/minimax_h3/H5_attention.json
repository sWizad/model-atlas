  "notes": [
    {
      "row": "notes",
      "title": "Why there is no cross-attention to add",
      "text": "Text rows are in the sequence, so a video row attends to text in exactly this operation. Wan needs a second sublayer (cross_attn) because its text never enters the sequence. One design pays for it in sequence length, the other in parameters and a second attention per block.",
      "code": [
        {
          "role": "definition",
