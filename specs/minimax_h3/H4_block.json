  "notes": [
    {
      "row": "notes",
      "title": "The order in one line",
      "text": "AdaLN → RMSNorm → modulate → SELF-ATTN → gated add → RMSNorm → modulate → SwiGLU MLP → gated add. Pre-norm, two sublayers, six taps — structurally the same shape as Wan's block with the cross-attention sublayer deleted.",
      "code": [
        {
          "role": "definition",
          "src": "mmx.dit",
          "lines": [
            363,
            381
          ],
          "expect": {
            "symbol": "MiniMaxH3TransformerBlock.forward",
            "first": "shift_msa, scale_msa, gate_msa, shift_mlp, scale_mlp, gate_mlp = self.adaln_proj(temb)",
            "sha": "c2375255",
            "span": [
              354,
              381
            ]
          }
        }
      ]
    },
    {
      "row": "notes",
      "title": "Three differences from Wan's block, and they all matter",
      "text": "1 — no cross-attention sublayer; text is in the sequence instead. 2 — RMSNorm, not LayerNorm. 3 — SwiGLU, not GELU MLP. Plus the taps are selected per row by adaln_indices rather than broadcast to every token.",
      "code": [
        {
          "role": "definition",
          "src": "mmx.dit",
          "lines": [
